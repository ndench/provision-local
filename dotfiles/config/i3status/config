# i3status configuration file.
# see "man i3status" for documentation.

general {
        colors = true
        interval = 5
}

order += "battery all"
order += "disk /"
order += "cpu_temperature 0"
order += "load"
order += "memory"
order += "tztime local"

battery all {
        format = "%status %percentage %remaining"
}

disk "/" {
        format = "%avail"
}

# CPU package temperature. hwmon numbers change between boots, so glob the coretemp path.
cpu_temperature 0 {
        format = "%degrees°C"
        max_threshold = 90
        path = "/sys/devices/platform/coretemp.0/hwmon/hwmon*/temp1_input"
}

load {
        format = "%1min"
}

memory {
        format = "%used / %available"
        threshold_degraded = "1G"
        format_degraded = "MEMORY < %available"
}

tztime local {
        format = "%c"
}
